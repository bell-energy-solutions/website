{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site on Cloudflare Workers. worker/index.js handles the www and http redirects;
  // everything else is served from ./dist.
  "name": "bell-energy-solutions-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "bellenergysolutions.com", "custom_domain": true },
    { "pattern": "www.bellenergysolutions.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true
}
