{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site on Cloudflare Workers (static assets only, no Worker script).
  "name": "bell-energy-solutions-site",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
