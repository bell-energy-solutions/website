{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(npm *)",
      "PowerShell(npx astro *)",
      "PowerShell(npx wrangler *)",
      "PowerShell(npx playwright *)",
      "PowerShell(node *)",
      "PowerShell(git *)",
      "PowerShell(gh *)",
      "Bash(npm *)",
      "Bash(npx astro *)",
      "Bash(npx wrangler *)",
      "Bash(npx playwright *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(gh *)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:cli.github.com)",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:web3forms.com)",
      "WebFetch(domain:help.formspree.io)",
      "WebFetch(domain:cloudflare-dns.com)",
      "WebFetch(domain:dns.google)",
      "WebFetch(domain:rdap.org)"
    ],
    "deny": [
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force *)",
      "PowerShell(git push * -f *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(npx wrangler delete *)",
      "PowerShell(wrangler delete *)",
      "PowerShell(Remove-Item * C:\\Windows*)",
      "PowerShell(Remove-Item * ~*)",
      "PowerShell(Remove-Item * C:\\Users\\*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(gh repo delete *)",
      "Bash(npx wrangler delete *)",
      "Bash(wrangler delete *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Read(~/.ssh/**)"
    ]
  }
}
