---
import '../styles/global.css';
import { business, credentials, services } from '../data/business';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/service-area/', label: 'Service Area' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const isCurrent = (href: string) => {
  const h = href.replace(/\/$/, '');
  return path === h || path.startsWith(h + '/');
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#13243c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>{business.name}</a>
        <nav class="nav" id="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="btn-row" style="gap:8px;flex-wrap:nowrap">
          <a class="btn btn-primary header-call" href={business.phoneHref} aria-label={`Call ${business.phone}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>
            <span class="btn-label">{business.phone}</span>
          </a>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <section class="cta-band" aria-label="Contact">
      <div class="container">
        <div>
          <h2>Schedule testing or request a quote</h2>
          <p>{business.hours}. {business.hoursNote}</p>
        </div>
        <div class="btn-row">
          <a class="btn btn-light" href={business.phoneHref}>Call {business.phone}</a>
          <a class="btn btn-light" href="/contact/">Request a quote</a>
        </div>
      </div>
    </section>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h3>{business.name}</h3>
            <p>ERI scores, third-party air leakage testing, thermal imaging, radon testing, and Washington State Energy Code compliance help.</p>
            <p><a href={business.phoneHref}>{business.phone}</a><br /><a href={`mailto:${business.email}`}>{business.email}</a></p>
          </div>
          <div>
            <h3>Services</h3>
            <ul>
              {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
            </ul>
          </div>
          <div>
            <h3>Hours</h3>
            <p>{business.hours}<br />{business.hoursNote}</p>
            <h3>Area</h3>
            <p><a href="/service-area/">Spokane County, WA<br />Kootenai County, ID</a></p>
          </div>
          <div>
            <h3>Credentials</h3>
            <ul>
              {credentials.map((c) => <li>{c}</li>)}
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} {business.name}</span>
          <a href="/privacy/">Privacy Policy</a>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open') ?? false;
        toggle.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
