---
import Base from '../layouts/Base.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import CertifiedBy from '../components/CertifiedBy.astro';
import { business, credentials, services, serviceArea } from '../data/business';
import twoFan from '../assets/photos/blower-door-two-fan-setup.jpg';
import frames from '../assets/photos/retrotec-blower-door-frames.jpg';
---
<Base
  title="Comfortable, Long-Lasting Homes | Bell Energy Solutions"
  description="We help people design comfortable, long-lasting homes: consulting, design, and third-party testing. Spokane-based, serving Eastern WA and North Idaho."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Spokane-based · Eastern Washington &amp; North Idaho</p>
        <h1>Comfortable, long-lasting homes, proven by testing</h1>
        <p class="lead">We're here to help you design homes people love living in, and that last. We work with builders, architects, engineering firms, and home designers from consulting and design through third-party testing, and ERI scores show the results.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={business.phoneHref}>Call {business.phone}</a>
          <a class="btn btn-light" href="/contact/">Request a quote</a>
        </div>
      </div>
      <PhotoSlot label="Hero: blower door test or job site" image={twoFan} alt="Two Retrotec blower door fans set up in an exterior doorway during an air leakage test" position="50% 62%" eager />
    </div>
  </section>

  <CertifiedBy />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2>Consulting, design, and third-party testing</h2>
        <p>Plan it right, test it, and prove it. We help with the design up front, verify the work with third-party testing, and show the results with ERI scores.</p>
      </div>
      <div class="grid-3">
        {services.map((s) => (
          <a class="card card-link" href={`/services/${s.slug}/`}>
            {s.homeowners && <span class="tag">Also for homeowners</span>}
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <span class="more">Details</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container grid-2">
      <div>
        <h2>Credentials</h2>
        <ul class="checklist">
          {credentials.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow">Who we work with</p>
        <h2>Built for project teams</h2>
        <p>We work with builders, architects, engineering firms, and home designers from design through testing, including Washington State Energy Code compliance for Washington projects.</p>
        <p>Working on a commercial project? Our <a href="/services/commercial-blower-door-testing/">commercial blower door testing</a>, including multi-fan setups, helps you meet the Washington State Energy Code.</p>
        <p>Homeowners can book blower door testing, radon testing, and thermal imaging.</p>
        <div class="callout">
          <strong>Service area:</strong> {serviceArea.line}. <a href="/service-area/">See towns</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <PhotoSlot label="Thermal image or testing equipment" wide image={frames} alt="Retrotec blower door frames with red SmartCloth panels" position="50% 52%" />
      <div>
        <p class="eyebrow">Scheduling</p>
        <h2>By appointment</h2>
        <dl class="spec">
          <div><dt>Hours</dt><dd>{business.hours}</dd></div>
          <div><dt>Scheduling</dt><dd>{business.hoursNote}</dd></div>
          <div><dt>Pricing</dt><dd>{business.quoteLine}</dd></div>
          <div><dt>Phone</dt><dd><a href={business.phoneHref}>{business.phone}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${business.email}`}>{business.email}</a></dd></div>
        </dl>
      </div>
    </div>
  </section>
</Base>
