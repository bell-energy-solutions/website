---
import Service from '../../layouts/Service.astro';
import { serviceArea, business } from '../../data/business';
---
<Service
  slug="design-consulting"
  title="Comfortable Home Design Consulting | Bell Energy Solutions"
  description="Design help and consulting for more comfortable homes in Spokane County and Kootenai County, from Bell Energy Solutions."
  heading="Design Consulting"
  lead="Design help and consulting for more comfortable homes."
  photo="Design meeting or plans"
>
  <h2>Comfort starts in design</h2>
  <p>Bell Energy Solutions helps people design and plan more comfortable homes. Call or send a message to talk through your project.</p>

  <dl class="spec" slot="aside" style="margin-top:20px">
    <div><dt>Service</dt><dd>Design help and consulting</dd></div>
    <div><dt>Area</dt><dd>{serviceArea.line}</dd></div>
    <div><dt>Pricing</dt><dd>{business.quoteLine}</dd></div>
  </dl>
</Service>
