---
import Base from '../layouts/Base.astro';
import { business } from '../data/business';
---
<Base
  title="Privacy Policy | Bell Energy Solutions"
  description="How Bell Energy Solutions handles information you share through the contact form, by phone, or by email."
>
  <section class="page-head">
    <div class="container">
      <h1>Privacy Policy</h1>
      <p class="lead">Plain-language summary of how this website handles your information.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:760px">
      <h2>What this website collects</h2>
      <p>This website does not use cookies, analytics, advertising, or tracking tools. It only collects what you choose to send through the contact form.</p>

      <h2>The contact form</h2>
      <p>The contact form asks for your name, email address, and message, and optionally your phone number and the service you're interested in.</p>
      <p>When you send it, the form is processed by <a href="https://web3forms.com/privacy" rel="noopener">Web3Forms</a>, a form-delivery service, which emails your message to Bell Energy Solutions. Web3Forms handles it under its own privacy policy. Your message then arrives in our business email.</p>

      <h2>How we use it</h2>
      <p>We use what you send, and anything you share by phone or email, only to respond to you and to provide the services you ask about. Messages are kept in our business email.</p>

      <h2>Questions</h2>
      <p>Email <a href={`mailto:${business.email}`}>{business.email}</a> or call <a href={business.phoneHref}>{business.phone}</a>.</p>
    </div>
  </section>
</Base>
