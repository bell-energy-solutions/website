---
import Base from '../layouts/Base.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { credentials, serviceArea } from '../data/business';
---
<Base
  title="About | Bell Energy Solutions"
  description="We're here to help people design comfortable, long-lasting homes. Spokane-based consulting, design, and third-party testing."
>
  <section class="page-head">
    <div class="container">
      <h1>About Bell Energy Solutions</h1>
      <p class="lead">We're here to help people design comfortable, long-lasting homes. That's our goal and our vision.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <div>
        <h2>Why we do this</h2>
        <p>A home should feel good to live in, and it should last. That starts long before the drywall goes up, with good design decisions and a building envelope that's done right.</p>
        <p>So we work alongside builders, architects, engineering firms, and home designers through consulting and design, then third-party test the finished work. ERI scores show the results, so everyone can see the home is comfortable and built to last.</p>

        <h2>What Bell Energy Solutions does</h2>
        <p>Consulting, design, and third-party testing are the heart of the business. Commercial blower door testing, including multi-fan setups, is a key part too, helping projects meet the Washington State Energy Code. We also offer thermal imaging, radon testing, and Washington State Energy Code compliance help.</p>
        <p>Homeowners can book blower door testing, radon testing, and thermal imaging directly with us.</p>
        <p>We're a Spokane-based company serving {serviceArea.summary}.</p>
      </div>
      <PhotoSlot label="Owner portrait or team on site" />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Credentials</h2>
      <ul class="checklist" style="max-width:720px">
        {credentials.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>
</Base>
