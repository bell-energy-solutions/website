---
import Base from '../layouts/Base.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { credentials, serviceArea } from '../data/business';
---
<Base
  title="About | Bell Energy Solutions"
  description="Bell Energy Solutions provides ERI scores, blower door, thermal imaging, and radon testing. BSI Level 2 Verifier, ENERGY STAR Verifier, NRPP certified."
>
  <section class="page-head">
    <div class="container">
      <h1>About Bell Energy Solutions</h1>
      <p class="lead">ERI scores, third-party air leakage testing, thermal imaging, radon testing, design consulting, and Washington State Energy Code compliance help.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <div>
        <h2>What we do</h2>
        <p>The core of the business is ERI scores. Alongside them, Bell Energy Solutions provides third-party air leakage testing, active thermography, radon testing, design consulting for more comfortable homes, and help achieving the Washington State Energy Code.</p>
        <p>Clients include builders, architects, engineering firms, and home designers. Homeowners can book blower door testing, radon testing, and thermal imaging.</p>
        <p>Bell Energy Solutions primarily works in {serviceArea.summary}.</p>
      </div>
      <PhotoSlot label="Owner portrait or team on site" />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Credentials</h2>
      <ul class="checklist" style="max-width:720px">
        {credentials.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>
</Base>
