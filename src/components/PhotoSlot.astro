---
// A photo, or a placeholder until the owner supplies one (business-facts.md: "leave spaces for photos").
// Owner photos live in src/assets/photos, resized and stripped of metadata by .site-builder/prep-photo.mjs.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  label: string;
  wide?: boolean;
  image?: ImageMetadata;
  alt?: string;
  position?: string;
  eager?: boolean;
}
const { label, wide = false, image, alt = '', position = 'center', eager = false } = Astro.props;
---
{image ? (
  <figure class:list={['photo', { wide }]}>
    <Image
      src={image}
      alt={alt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 860px) 100vw, 560px"
      loading={eager ? 'eager' : 'lazy'}
      style={`object-position: ${position}`}
    />
  </figure>
) : (
  <div class:list={['photo-slot', { wide }]} role="presentation" data-photo-needed={label}></div>
)}
